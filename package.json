{
  "name": "avlmc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:discovery": "rm -rf /tmp/avlmc-discovery-tests && tsc -p tests/tsconfig.discovery.json && node --test /tmp/avlmc-discovery-tests/tests/discovery-scoring.test.js",
    "test:event-dedupe": "rm -rf /tmp/avlmc-event-dedupe-tests && tsc --target es2022 --module commonjs --moduleResolution node --rootDir . --outDir /tmp/avlmc-event-dedupe-tests --esModuleInterop --skipLibCheck --strict tests/event-dedupe.test.ts lib/event-dedupe.ts && node --test /tmp/avlmc-event-dedupe-tests/tests/event-dedupe.test.js",
    "test:image-resilience": "rm -rf /tmp/avlmc-image-resilience-tests && tsc --target es2022 --module commonjs --moduleResolution node --rootDir . --outDir /tmp/avlmc-image-resilience-tests --esModuleInterop --skipLibCheck --strict tests/image-resilience.test.ts lib/image-resilience.ts && node --test /tmp/avlmc-image-resilience-tests/tests/image-resilience.test.js",
    "test:taxonomy": "rm -rf /tmp/avlmc-taxonomy-tests && tsc -p tests/tsconfig.taxonomy.json && node --test /tmp/avlmc-taxonomy-tests/tests/genre-taxonomy.test.js",
    "test:shared-songs": "rm -rf /tmp/avlmc-shared-songs-tests && tsc -p tests/tsconfig.shared-songs.json && node --test /tmp/avlmc-shared-songs-tests/tests/shared-songs.test.js",
    "test:insight": "rm -rf /tmp/avlmc-insight-tests && tsc -p tests/tsconfig.insight.json && node --test /tmp/avlmc-insight-tests/tests/insight-metrics.test.js",
    "test:social-graph": "rm -rf /tmp/avlmc-social-graph-tests && tsc -p tests/tsconfig.social-graph.json && node --test /tmp/avlmc-social-graph-tests/tests/social-graph.test.js",
    "test:social-activity": "rm -rf /tmp/avlmc-social-activity-tests && tsc -p tests/tsconfig.social-activity.json && node --test /tmp/avlmc-social-activity-tests/tests/social-activity.test.js",
    "test:curators": "rm -rf /tmp/avlmc-curators-tests && tsc -p tests/tsconfig.curators.json && node --test /tmp/avlmc-curators-tests/tests/curators.test.js",
    "test:curator-recommendations": "rm -rf /tmp/avlmc-curator-recommendations-tests && tsc -p tests/tsconfig.curator-recommendations.json && node --test /tmp/avlmc-curator-recommendations-tests/tests/curator-recommendations.test.js",
    "test:account-linking": "rm -rf /tmp/avlmc-account-linking-tests && tsc -p tests/tsconfig.account-linking.json && node --test /tmp/avlmc-account-linking-tests/tests/account-linking.test.js",
    "test:spotify-access": "rm -rf /tmp/avlmc-spotify-access-tests && tsc -p tests/tsconfig.spotify-access.json && node --test /tmp/avlmc-spotify-access-tests/tests/spotify-access-requests.test.js",
    "test:tester-requests": "rm -rf /tmp/avlmc-tester-requests-tests && tsc -p tests/tsconfig.tester-requests.json && node --test /tmp/avlmc-tester-requests-tests/tests/tester-requests.test.js",
    "test:auth-failures": "rm -rf /tmp/avlmc-auth-failures-tests && tsc -p tests/tsconfig.auth-failures.json && node --test /tmp/avlmc-auth-failures-tests/tests/auth-failures.test.js",
    "test:auth-email": "rm -rf /tmp/avlmc-auth-email-tests && tsc -p tests/tsconfig.auth-email.json && node --test /tmp/avlmc-auth-email-tests/tests/auth-email.test.js",
    "test:feedback": "rm -rf /tmp/avlmc-feedback-tests && tsc -p tests/tsconfig.feedback.json && node --test /tmp/avlmc-feedback-tests/tests/feedback.test.js",
    "test:account-integrity": "rm -rf /tmp/avlmc-account-integrity-tests && tsc -p tests/tsconfig.account-integrity.json && node --test /tmp/avlmc-account-integrity-tests/tests/account-integrity.test.js",
    "test:e2e": "playwright test",
    "test:readability": "playwright test --config playwright.smoke.config.ts",
    "test:account-loop": "TSX_TSCONFIG_PATH=tests/tsconfig.account-loop.json node --import tsx --test tests/account-loop.integration.mts",
    "test:one-identity": "TSX_TSCONFIG_PATH=tests/tsconfig.account-loop.json node --import tsx --test tests/one-identity.integration.mts",
    "test:social-guardrails": "rm -rf /tmp/avlmc-social-guardrails-tests && tsc -p tests/tsconfig.social-guardrails.json && node --test /tmp/avlmc-social-guardrails-tests/tests/social-guardrails.test.js",
    "test:personalization-benchmark": "rm -rf /tmp/avlmc-personalization-benchmark-tests && tsc -p tests/tsconfig.personalization-benchmark.json && node --test /tmp/avlmc-personalization-benchmark-tests/tests/personalization-benchmark.test.js",
    "test:registry": "node --import tsx --test tests/system-registry.test.ts",
    "test:cron-auth": "node --import tsx --test tests/cron-auth.test.ts",
    "test:blob-guard": "node --import tsx --test tests/blob-ingest-guard.test.ts",
    "test:read-path": "node --import tsx --test tests/read-path-fallback.test.ts",
    "test:events-cache": "node --import tsx --test tests/events-cache.test.ts",
    "test:write-rate-limits": "node --import tsx --test tests/write-rate-limits.test.ts",
    "test:signin-event": "TSX_TSCONFIG_PATH=tests/tsconfig.signin-event.json node --import tsx --test tests/signin-event.test.ts",
    "test:spotify-gate": "node --import tsx --test tests/spotify-gate.test.ts",
    "test:spotify-reconnect": "node --import tsx --test tests/spotify-reconnect.test.ts",
    "test:artist-match": "rm -rf /tmp/avlmc-artist-match-tests && tsc -p tests/tsconfig.artist-match.json && node --test /tmp/avlmc-artist-match-tests/tests/artist-match.test.js",
    "test:hover-player": "rm -rf /tmp/avlmc-hover-player-tests && tsc -p tests/tsconfig.hover-player.json && node --test /tmp/avlmc-hover-player-tests/tests/hover-player.test.js",
    "test:audius-core": "rm -rf /tmp/avlmc-audius-core-tests && tsc -p tests/tsconfig.audius-core.json && node --test /tmp/avlmc-audius-core-tests/tests/audius-core.test.js",
    "generate:system-map": "tsx scripts/generate-system-map.ts",
    "db:apply": "tsx scripts/apply-schema.ts",
    "backfill:artist-matches": "tsx scripts/backfill-artist-matches.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.2",
    "@vercel/blob": "^2.4.0",
    "lucide-react": "^1.17.0",
    "next": "15.5.19",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "20.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.19",
    "tsx": "^4.22.4",
    "typescript": "5.6.3"
  }
}
