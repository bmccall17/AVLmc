{
  "name": "avlmc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:discovery": "rm -rf /tmp/avlmc-discovery-tests && tsc -p tests/tsconfig.discovery.json && node --test /tmp/avlmc-discovery-tests/tests/discovery-scoring.test.js",
    "test:event-dedupe": "rm -rf /tmp/avlmc-event-dedupe-tests && tsc --target es2022 --module commonjs --moduleResolution node --rootDir . --outDir /tmp/avlmc-event-dedupe-tests --esModuleInterop --skipLibCheck --strict tests/event-dedupe.test.ts lib/event-dedupe.ts && node --test /tmp/avlmc-event-dedupe-tests/tests/event-dedupe.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.2",
    "lucide-react": "^1.17.0",
    "next": "15.5.19",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.19",
    "typescript": "5.6.3"
  }
}
